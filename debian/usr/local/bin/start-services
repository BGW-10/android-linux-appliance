#!/bin/sh
# Run as root inside Debian. Add services under /etc/sv, enable in /etc/service.
set -eu
[ "$#" -eq 0 ] || { echo 'Use sv to stop, restart, or inspect services.' >&2; exit 2; }
export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
export HOME=/root USER=root LOGNAME=root
mkdir -p /etc/service /run

# Keep the appliance awake until reboot or an explicit manual release.
# Deliberately keep this lock if runit exits while service processes remain.
printf 'klipper-appliance\n' > /sys/power/wake_lock

# util-linux flock prevents duplicate launches. --close keeps the lock file
# descriptor out of services, so they cannot accidentally retain it.
exec /usr/bin/flock --nonblock --close /run/appliance-runsvdir.lock \
    /usr/bin/runsvdir -P /etc/service
